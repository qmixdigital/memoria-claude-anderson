# Segredos do motor de pautas. Modo 600, dono motorpautas.
# Lido pelo systemd via EnvironmentFile.

MP_DSN=<<REMOVIDO>>

# ---------------------------------------------------------------- provedores
ANTHROPIC_API_KEY=
RUNWARE_API_KEY=

# OpenAI e DEPENDENCIA DE PRODUCAO, nao so do teste cego: os embeddings do
# dedupe usam esta mesma chave. Sem ela o motor agrupa so pela peneira de
# fichas raras e fragmenta cluster (o mesmo fato vira dois).
OPENAI_API_KEY=
MP_MODELO_OPENAI=gpt-5.6-luna

# Embeddings: openai (padrao) ou voyage
MP_PROVEDOR_EMBEDDING=openai
VOYAGE_API_KEY=

# ------------------------------------------------------------------- alertas
# Canal ativo: telegram. Aceita tambem `smtp` ou `ambos`.
MP_CANAL_ALERTA=telegram

# Bot do Telegram. Os tres gatilhos (degrau de US$ 5 por provedor, corte do
# teto, credito/auth) vao por aqui.
#   1. criar o bot no @BotFather e copiar o token
#   2. mandar QUALQUER mensagem para o bot no Telegram
#   3. python -m motor_pautas chat-id   -> mostra o chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ALTERNATIVA por SMTP. Fica no codigo, funcional, mas so e usada com
# MP_CANAL_ALERTA=smtp ou =ambos. Serve Gmail, Resend ou qualquer outro.
#
#   Resend:  SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USER=resend
#            SMTP_PASS=re_xxxx  SMTP_FROM=motor@qmix.com.br (dominio verificado)
#   Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#            SMTP_USER=qmixdigital@gmail.com
#            SMTP_PASS=<senha de app de 16 caracteres>  (exige 2FA)
ALERTA_EMAIL=qmixdigital@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Link do painel nos e-mails. Deixar vazio usa a instrucao do tunel SSH.
MP_URL_PAINEL=
