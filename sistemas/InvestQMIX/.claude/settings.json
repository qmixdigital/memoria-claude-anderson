{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Glob",
      "Grep",
      "TodoWrite",
      "SlashCommand",
      "Skill",
      "Agent",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(tsc *)",
      "Bash(vitest *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(diff *)",
      "Bash(awk *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(find *)",
      "Bash(xargs *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(plink *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(chmod *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /home/*)",
      "Bash(rm -rf /root/*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(:(){ :|: & };:)",
      "Write(/etc/*)",
      "Write(/usr/*)",
      "Write(/bin/*)"
    ]
  }
}
